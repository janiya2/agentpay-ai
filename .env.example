# ==============================================================================
# AgentPay AI — Environment Configuration Example
# Official Submission for PayPal AI Hackathon 2026
# ==============================================================================

# Google Gemini AI Inference Engine (Gemini 2.5 Flash)
GEMINI_API_KEY="your_google_ai_studio_api_key_here"
NEXT_PUBLIC_GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# Multi-Key Failover Pool (Comma-separated keys for automatic rate-limit rotation)
GEMINI_API_KEYS="your_key_1,your_key_2"

# PayPal Developer Platform Credentials (Sandbox / Live)
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_MODE="sandbox" # "sandbox" or "live"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id_here"

# Google Cloud Firebase Configuration (Firestore Database)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# Resend Transactional Email Engine
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Platform Administrative Master Passcode
ADMIN_PASSCODE="innoxpert2026"

